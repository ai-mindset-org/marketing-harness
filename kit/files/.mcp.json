{
  "mcpServers": {
    "exa": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp?exaApiKey=${EXA_API_KEY}&tools=web_search_exa,web_fetch_exa,web_search_advanced_exa"
    },
    "lms": {
      "command": "node",
      "args": ["tools/mcp/lms.mjs"],
      "env": { "AIM_LMS_TOKEN": "${AIM_LMS_TOKEN}" }
    }
  }
}
